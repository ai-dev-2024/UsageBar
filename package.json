{
  "name": "usagebar",
  "version": "1.5.0",
  "description": "Windows system tray app showing AI coding tool usage stats",
  "main": "dist/main/index.js",
  "author": "UsageBar",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "powershell -Command \"if (-not (Test-Path dist/renderer)) { New-Item -ItemType Directory -Path dist/renderer }; Copy-Item src/renderer/*.html, src/renderer/*.png dist/renderer/\"",
    "start": "electron .",
    "package": "electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "npx playwright test",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.html\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.html\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.usagebar.app",
    "productName": "UsageBar",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "dir",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ]
  }
}
